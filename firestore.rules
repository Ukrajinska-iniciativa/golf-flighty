rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Správci: sem patří Google účty, které smějí měnit data.
    function admin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['SPRAVCE@EXAMPLE.CZ'];
    }
    match /players/{id}  { allow read: if true; allow write: if admin(); }
    match /events/{id}   { allow read: if true; allow write: if admin(); }
    match /settings/{id} { allow read, write: if admin(); }
  }
}
